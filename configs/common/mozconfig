# Orbit build options shared by every platform.
# ${binName}, ${brandingDir} and ${changeset} are filled in by surfer.

ac_add_options --enable-application=browser
ac_add_options --with-app-name=${binName}
ac_add_options --with-app-basename=Orbit
export MOZ_APP_BASENAME=Orbit
export MOZ_BRANDING_DIRECTORY=${brandingDir}
export MOZ_OFFICIAL_BRANDING_DIRECTORY=${brandingDir}
ac_add_options --with-distribution-id=app.orbit-browser

export MOZ_SOURCE_REPO=https://github.com/realshavkat/orbit
export MOZ_SOURCE_CHANGESET=${changeset}
export MOZ_INCLUDE_SOURCE_INFO=1

# Fetch clang/rust/nasm/etc. toolchains automatically.
ac_add_options --enable-bootstrap

ac_add_options --enable-release
ac_add_options --disable-debug-symbols
ac_add_options --disable-tests
ac_add_options --disable-crashreporter
ac_add_options --disable-geckodriver
ac_add_options --disable-rust-tests
ac_add_options --disable-default-browser-agent

# Bundled Orbit language packs are repacked (unsigned) and live in the app dir.
ac_add_options --with-unsigned-addon-scopes=app,system
ac_add_options --allow-addon-sideload

# No telemetry pipeline.
mk_add_options MOZ_DATA_REPORTING=
mk_add_options MOZ_SERVICES_HEALTHREPORT=
mk_add_options MOZ_TELEMETRY_REPORTING=
ac_add_options MOZ_DATA_REPORTING=
ac_add_options MOZ_TELEMETRY_REPORTING=

# Add-on signatures stay required by default (xpinstall.signatures.required),
# but are no longer forced by the build: Orbit's settings can allow Chrome
# Web Store and other unsigned extensions when the user asks for it.
export MOZ_REQUIRE_SIGNING=

# Release CI only (slow, memory hungry): ORBIT_RELEASE=1 enables LTO.
if test "$ORBIT_RELEASE"; then
  export MOZ_LTO=cross,thin
  ac_add_options --enable-lto=cross,thin
  mk_add_options MOZILLA_OFFICIAL=1
  export MOZILLA_OFFICIAL=1
fi
